{
  "name": "Daymark — Daily check-ins",
  "short_name": "Daymark",
  "description": "Make a daily promise and mark it done.",
  "id": "/Daymark/",
  "start_url": "/Daymark/",
  "scope": "/Daymark/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#10081f",
  "theme_color": "#10081f",
  "categories": ["lifestyle", "productivity", "health"],
  "icons": [
    {
      "src": "/Daymark/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Daymark/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Daymark/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
